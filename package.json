{
	"name": "agentos",
	"version": "0.1.12",
	"private": true,
	"description": "A unified, purpose-built interface to interact with agents safely",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"preview": "electron-vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"dist": "npm run build && electron-builder",
		"dist:linux": "npm run build && electron-builder --linux",
		"dist:win": "npm run build && electron-builder --win",
		"dist:mac": "npm run build && electron-builder --mac"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.2.0",
		"electron": "^43.4.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"shadcn": "^4.18.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^7.3.6",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.233",
		"@fontsource-variable/geist": "^5.3.0",
		"@shadcn/react": "^0.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"license": "MIT",
	"desktopName": "agentos.desktop",
	"author": {
		"name": "Protoku",
		"email": "jeroen@herczeg.be"
	},
	"homepage": "https://github.com/protoku/agentos",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/protoku/agentos.git"
	}
}
